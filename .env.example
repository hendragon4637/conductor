# Conductor backend env template — copy to .env and fill in

# Postgres
DATABASE_URL=postgresql://aipc:CHANGEME@localhost:5432/aipc_conductor

# Langfuse (reuse existing project or new)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse.aipc.local

# OpenCode storage path — NOTE: v1.14 stores data in opencode.db (SQLite),
# not in directory-per-entity. The adapter (file 07) queries the SQLite DB.
OPENCODE_STORAGE_PATH=/home/aipc/.local/share/opencode/storage
OPENCODE_DB_PATH=/home/aipc/.local/share/opencode/opencode.db

# Workspace root (where git repos live)
WORKSPACE_ROOT=/opt/aipc/conductor/workspace

# Skills root
SKILLS_ROOT=/opt/aipc/conductor/skills

# Terminal emulator command (gnome-terminal or alternative)
TERMINAL_CMD=gnome-terminal
MEMORY_ROOT=/opt/aipc/conductor/memory

# JWT / Auth
JWT_SECRET_KEY=change-me-to-a-256-bit-hex-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
REFRESH_ROTATION_GRACE=30

# FastAPI
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8090

# UI dev server port
UI_DEV_PORT=3090
