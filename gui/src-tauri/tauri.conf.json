{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIPC Conductor",
  "version": "0.1.0",
  "identifier": "io.aipc.conductor",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:3090",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "AIPC Conductor",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
